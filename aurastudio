#!/data/data/com.termux/files/usr/bin/env bash
# shellcheck disable=SC1091
# ╭──────────────────────────────────────────────────────────────╮
# │    ⚡  AuraStudio CLI  v1.1                                  │
# │        Build Android, Anywhere                               │
# ╰──────────────────────────────────────────────────────────────╯

# Resolve Script Root Directory (Supports Symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
AURA_ROOT="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# Load Core Configurations & Libraries
source "$AURA_ROOT/config/env.sh"
source "$AURA_ROOT/lib/ui.sh"
source "$AURA_ROOT/lib/utils.sh"
source "$AURA_ROOT/lib/tools.sh"

# Load Command Modules
source "$AURA_ROOT/modules/setup.sh"
source "$AURA_ROOT/modules/sdk.sh"
source "$AURA_ROOT/modules/use.sh"
source "$AURA_ROOT/modules/ndk.sh"
source "$AURA_ROOT/modules/cmake.sh"
source "$AURA_ROOT/modules/remove.sh"
source "$AURA_ROOT/modules/clean.sh"
source "$AURA_ROOT/modules/init.sh"
source "$AURA_ROOT/modules/update.sh"
source "$AURA_ROOT/modules/uninstall.sh"
source "$AURA_ROOT/modules/status.sh"
source "$AURA_ROOT/modules/doctor.sh"

# Load User Plugins
load_plugins

# Process Global Flags (--verbose / -v)
for arg in "$@"; do
    if [ "$arg" = "--verbose" ] || [ "$arg" = "-v" ]; then
        export DEBUG=1
    fi
done

# Check dependencies on startup (except for help/version)
CLI_EXIT_CODE=0
_skip_dep_check=false
case "${1:-}" in
    help|-help|--help|"") _skip_dep_check=true ;;
    version|-v|--version) _skip_dep_check=true ;;
    man) _skip_dep_check=true ;;
esac

if [ "$_skip_dep_check" = false ]; then
    check_all_deps || exit 1
fi

# CLI Command Router
case "${1:-}" in
    setup)   cmd_setup || CLI_EXIT_CODE=$? ;;
    install)
        case "${2:-}" in
            ndk)   cmd_install_ndk || CLI_EXIT_CODE=$? ;;
            cmake) cmd_install_cmake || CLI_EXIT_CODE=$? ;;
            sdk)   cmd_install_sdk "${@:3}" || CLI_EXIT_CODE=$? ;;
            *)
                error "Unknown command: aurastudio install ${2:-}"
                printf "  %b\n" "${MUTED}Available: aurastudio install sdk | ndk | cmake${RESET}"
                CLI_EXIT_CODE=1 ;;
        esac ;;
    use)
        case "${2:-}" in
            java)  cmd_use_java "${3:-}" || CLI_EXIT_CODE=$? ;;
            *)
                error "Unknown command: aurastudio use ${2:-}"
                printf "  %b\n" "${MUTED}Available: aurastudio use java 17 | 21${RESET}"
                CLI_EXIT_CODE=1 ;;
        esac ;;
    remove)       cmd_remove "${2:-}" "${3:-}" "${4:-}" || CLI_EXIT_CODE=$? ;;
    clean)        cmd_clean || CLI_EXIT_CODE=$? ;;
    init)         cmd_init || CLI_EXIT_CODE=$? ;;
    update)       cmd_update || CLI_EXIT_CODE=$? ;;
    check-update) cmd_update --check || CLI_EXIT_CODE=$? ;;
    uninstall)    cmd_uninstall || CLI_EXIT_CODE=$? ;;
    status)
        if [ "${2:-}" = "--json" ] || [ "${2:-}" = "-j" ]; then
            output_json_status
        else
            cmd_status || CLI_EXIT_CODE=$?
        fi
        ;;
    doctor)       cmd_doctor "${2:-}" || CLI_EXIT_CODE=$? ;;
    man)          show_man_page ;;
    version|-v|--version) printf "\n  %b v%s\n\n" "${INDIGO}AuraStudio CLI${RESET}" "${CLI_VERSION}" ;;
    help|-help|--help|"")
        show_help ;;
    *)
        error "Unknown command: ${1}"
        printf "  %b\n" "${MUTED}Run: aurastudio --help${RESET}"
        CLI_EXIT_CODE=1 ;;
esac

exit "$CLI_EXIT_CODE"
